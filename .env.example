# Database
POKER_AI_DB=var/poker_ai_local.db
POKER_AI_ENV=local

# Authentication (disabled by default in dev)
POKER_AUTH_ENABLED=false
POKER_JWT_SECRET=dev-secret-change-me

# CORS
POKER_CORS_ORIGINS=*

# Rate limiting (requests per minute)
POKER_RATE_LIMIT_RPM=120

# Logging
POKER_LOG_LEVEL=INFO

# OpenTelemetry tracing (optional)
POKER_OTEL_ENABLED=false
POKER_OTEL_ENDPOINT=http://localhost:4317

# Session runner
POKER_SESSION_MAX_WORKERS=4
POKER_SESSION_PARALLEL_THRESHOLD=9999

# Base directory
POKER_BASE_DIR=.
